3. تطوير محرك التعرف على المشاهد والحجب في app/src/main/java/com/example/ai/AiAnalyzer.kt
استبدل محتوى ملف AiAnalyzer.kt بالكامل بهذا الكود المطور الذي يعالج:
 * مشكلة توقف الفحص إذا كانت قائمة scenes فارغة (بإنشاء نطاق فحص تلقائي لكامل الفيديو).
 * مشكلة تكرار الإطارات عبر استبدال OPTION_CLOSEST_SYNC بـ OPTION_CLOSEST مع آلية Fallback ذكية.
 * إضافة خوارزمية تحليل نسبة لون البشرة والتعرض البصري (calculateSkinExposureRatio) بجانب نموذج ML Kit لرفع دقة رصد المشاهد الحساسة وتوليد فترات الحجب مع هامش أمان زمني (Pre-roll & Post-roll Cooldown):
package com.example.ai

import android.content.Context
import android.graphics.Bitmap
import android.graphics.Color
import android.media.MediaMetadataRetriever
import android.net.Uri
import android.os.Build
import com.example.data.MediaItem
import com.example.data.MediaRepository
import com.example.data.Scene
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.firstOrNull
import kotlinx.coroutines.withContext

data class AiAnalysisProgress(
    val mediaId: Int = -1,
    val isAnalyzing: Boolean = false,
    val totalDurationMs: Long = 0,
    val processedMs: Long = 0,
    val detectionsFound: Int = 0,
    val status: String = "IDLE",
    val errorMessage: String? = null,
    val strategy: AiStrategy = AiStrategy.BALANCED
)

class AiAnalyzer(
    private val context: Context,
    private val repository: MediaRepository
) {
    private val _progress = MutableStateFlow(AiAnalysisProgress())
    val progress: StateFlow<AiAnalysisProgress> = _progress.asStateFlow()

    @Volatile
    private var isCancelled = false

    fun cancel() {
        isCancelled = true
    }

    suspend fun analyzeMedia(mediaItem: MediaItem, sensitivity: String = "MEDIUM") = withContext(Dispatchers.IO) {
        if (_progress.value.isAnalyzing) return@withContext

        isCancelled = false
        val capabilities = getDeviceCapabilities(context)
        val strategy = determineAiStrategy(capabilities)

        _progress.value = AiAnalysisProgress(
            mediaId = mediaItem.id,
            isAnalyzing = true,
            totalDurationMs = mediaItem.durationMs,
            status = "PREPARING",
            strategy = strategy
        )

        repository.updateAiAnalysisStatus(mediaItem.id, "IN_PROGRESS", mediaItem.sizeBytes, mediaItem.dateModified)

        val retriever = MediaMetadataRetriever()
        val visualModel: VisualModel = MlKitVisualModel()

        try {
            retriever.setDataSource(context, Uri.parse(mediaItem.path))
            val durationStr = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)
            val durationMs = (durationStr?.toLongOrNull() ?: mediaItem.durationMs).coerceAtLeast(1000L)

            _progress.value = _progress.value.copy(totalDurationMs = durationMs, status = "ANALYZING")

            repository.clearDetectionResultsForMedia(mediaItem.id)
            visualModel.prepare()

            // إصلاح جذري: إذا لم يتم تشغيل SceneAnalyzer مسبقاً، ننشئ مشهداً يغطي الفيديو بالكامل
            val rawScenes = repository.getScenesForMedia(mediaItem.id).firstOrNull().orEmpty()
            val scenes = if (rawScenes.isEmpty()) {
                listOf(
                    Scene(
                        id = 1,
                        mediaId = mediaItem.id,
                        startTimeMs = 0L,
                        endTimeMs = durationMs,
                        thumbnailPath = "",
                        sceneIndex = 1
                    )
                )
            } else {
                rawScenes
            }

            val baseIntervalMs = when (strategy) {
                AiStrategy.LIGHT -> 3000L
                AiStrategy.BALANCED -> 1800L
                AiStrategy.ADVANCED -> 1000L
            }

            val intervalMs = when (sensitivity) {
                "LOW" -> (baseIntervalMs * 1.4).toLong()
                "HIGH" -> (baseIntervalMs * 0.5).toLong().coerceAtLeast(400L)
                else -> baseIntervalMs
            }

            val confidenceThreshold = when (sensitivity) {
                "LOW" -> 0.68f
                "HIGH" -> 0.45f
                else -> 0.55f
            }

            val skinRatioThreshold = when (sensitivity) {
                "LOW" -> 0.48f
                "HIGH" -> 0.30f
                else -> 0.38f
            }

            var detectionsCount = 0
            var currentDetectionStartMs: Long? = null
            var lastDetectionTimeMs: Long? = null
            val currentDetectedCategories = mutableMapOf<String, Float>()
            var currentSceneId = -1

            // السماح بفجوة زمنية (Hysteresis Cooldown) قدرها خطوتان لمنع تقطع الحجب
            val maxAllowedGapMs = intervalMs * 2

            suspend fun commitTemporalSegment() {
                if (currentDetectionStartMs != null && lastDetectionTimeMs != null && currentDetectedCategories.isNotEmpty()) {
                    val topCategory = currentDetectedCategories.maxByOrNull { it.value }!!
                    // إضافة هامش أمان قبل وبعد اللقطة لضمان تغطية سلسة
                    val safeStartMs = (currentDetectionStartMs!! - 300L).coerceAtLeast(0L)
                    val safeEndMs = (lastDetectionTimeMs!! + intervalMs + 500L).coerceAtMost(durationMs)

                    val result = DetectionResult(
                        mediaId = mediaItem.id,
                        sceneId = currentSceneId,
                        category = topCategory.key,
                        modality = "VISUAL",
                        startTimeMs = safeStartMs,
                        endTimeMs = safeEndMs,
                        confidence = topCategory.value,
                        modelId = visualModel.modelId,
                        modelVersion = visualModel.modelVersion,
                        sensitivity = sensitivity,
                        status = "ACCEPTED"
                    )
                    repository.saveDetectionResult(result)
                    detectionsCount++
                    _progress.value = _progress.value.copy(detectionsFound = detectionsCount)
                }
                currentDetectionStartMs = null
                lastDetectionTimeMs = null
                currentDetectedCategories.clear()
            }

            val sensitiveKeywords = setOf(
                "Flesh", "Violence", "Blood", "Weapon", "Skin", "Undergarment",
                "Swimwear", "Bikini", "Lingerie", "Barechested", "Cleavage",
                "Thigh", "Abdomen", "Chest", "Navel", "Intimate", "Kiss"
            )

            for (scene in scenes) {
                var currentMs = scene.startTimeMs
                currentSceneId = scene.id

                while (currentMs < scene.endTimeMs) {
                    if (isCancelled) {
                        commitTemporalSegment()
                        _progress.value = _progress.value.copy(isAnalyzing = false, status = "CANCELLED")
                        repository.updateAiAnalysisStatus(mediaItem.id, "NONE", 0, 0)
                        return@withContext
                    }

                    val bitmap = extractScaledFrameSafely(retriever, currentMs, 224, 224)

                    if (bitmap != null) {
                        val results = visualModel.analyzeFrame(bitmap)
                        val skinRatio = calculateSkinExposureRatio(bitmap)
                        bitmap.recycle()

                        val sensitiveResults = results.filter {
                            it.confidence >= confidenceThreshold &&
                                sensitiveKeywords.any { kw -> it.category.contains(kw, ignoreCase = true) }
                        }.toMutableList()

                        // دمج الفحص اللوني YCbCr مع تصنيفات الذكاء الاصطناعي لرفع الدقة
                        if (skinRatio >= skinRatioThreshold) {
                            val boostConfidence = (skinRatio * 1.35f).coerceIn(0.55f, 0.96f)
                            sensitiveResults.add(ModelResult(category = "Sensitive Skin Exposure", confidence = boostConfidence))
                        }

                        if (sensitiveResults.isNotEmpty()) {
                            if (currentDetectionStartMs == null) {
                                currentDetectionStartMs = currentMs
                            }
                            lastDetectionTimeMs = currentMs
                            sensitiveResults.forEach {
                                currentDetectedCategories[it.category] = maxOf(
                                    it.confidence,
                                    currentDetectedCategories[it.category] ?: 0f
                                )
                            }
                        } else if (lastDetectionTimeMs != null && (currentMs - lastDetectionTimeMs!!) > maxAllowedGapMs) {
                            commitTemporalSegment()
                        }
                    }

                    currentMs += intervalMs
                    _progress.value = _progress.value.copy(processedMs = currentMs.coerceAtMost(durationMs))
                }
                commitTemporalSegment()
            }

            _progress.value = _progress.value.copy(
                isAnalyzing = false,
                processedMs = durationMs,
                status = "COMPLETED"
            )
            repository.updateAiAnalysisStatus(mediaItem.id, "COMPLETED", mediaItem.sizeBytes, mediaItem.dateModified)

        } catch (e: Exception) {
            if (e is CancellationException) throw e
            _progress.value = _progress.value.copy(
                isAnalyzing = false,
                status = "FAILED",
                errorMessage = e.message
            )
            repository.updateAiAnalysisStatus(mediaItem.id, "NONE", 0, 0)
        } finally {
            try {
                retriever.release()
                visualModel.release()
            } catch (_: Exception) {}
        }
    }

    private fun extractScaledFrameSafely(
        retriever: MediaMetadataRetriever,
        timeMs: Long,
        width: Int,
        height: Int
    ): Bitmap? {
        val timeUs = timeMs * 1000L
        return try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
                retriever.getScaledFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST, width, height)
                    ?: retriever.getScaledFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST_SYNC, width, height)
            } else {
                val raw = retriever.getFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST)
                    ?: retriever.getFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
                raw?.let {
                    val scaled = Bitmap.createScaledBitmap(it, width, height, false)
                    if (scaled != it) it.recycle()
                    scaled
                }
            }
        } catch (_: Exception) {
            null
        }
    }

    /**
     * خوارزمية فحص الطيف اللوني YCbCr لحساب نسبة البشرة المكشوفة في مركز الإطار
     */
    private fun calculateSkinExposureRatio(bitmap: Bitmap): Float {
        val w = bitmap.width
        val h = bitmap.height
        val pixels = IntArray(w * h)
        bitmap.getPixels(pixels, 0, w, 0, 0, w, h)

        var skinPixels = 0
        var totalWeight = 0

        for (y in 0 until h step 2) {
            for (x in 0 until w step 2) {
                val pixel = pixels[y * w + x]
                val r = Color.red(pixel)
                val g = Color.green(pixel)
                val b = Color.blue(pixel)

                // تحويل RGB إلى YCbCr للكشف الدقيق تحت مختلف الإضاءات
                val cb = 128 - (0.168736f * r) - (0.331264f * g) + (0.5f * b)
                val cr = 128 + (0.5f * r) - (0.418688f * g) - (0.081312f * b)

                val isCenter = x in (w / 5)..(w * 4 / 5) && y in (h / 5)..(h * 4 / 5)
                val weight = if (isCenter) 2 else 1
                totalWeight += weight

                if (cr in 135f..180f && cb in 85f..135f && r > 80 && g > 35 && b > 15 && r > g && r > b) {
                    skinPixels += weight
                }
            }
        }
        return if (totalWeight > 0) skinPixels.toFloat() / totalWeight.toFloat() else 0f
    }
}

4. ترقية مظلل الحجب والتصدير في app/src/main/java/com/example/export/CensorEffect.kt
استبدل محتوى ملف CensorEffect.kt بالكامل ليقدم تمويهاً زجاجياً حقيقياً (Liquid Frosted Glass Blur مع حواف متدرجة ناعمة smoothstep وانكسار ضوئي مستوحى من Mpv-infinity) بدلاً من البكسلة المربعة الحادة:
package com.example.export

import android.content.Context
import androidx.media3.common.util.GlProgram
import androidx.media3.common.util.GlUtil
import androidx.media3.common.util.Size
import androidx.media3.effect.BaseGlShaderProgram
import androidx.media3.effect.GlEffect
import androidx.media3.effect.GlShaderProgram
import com.example.data.EditingOperation
import com.example.ui.editing.OperationProperties

@androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
class CensorEffect(private val operations: List<EditingOperation>) : GlEffect {
    override fun toGlShaderProgram(context: Context, useHdr: Boolean): GlShaderProgram {
        return CensorShaderProgram(context, operations, useHdr)
    }
}

@androidx.annotation.OptIn(androidx.media3.common.util.UnstableApi::class)
class CensorShaderProgram(
    context: Context,
    private val operations: List<EditingOperation>,
    useHdr: Boolean
) : BaseGlShaderProgram(useHdr, 1) {

    private val glProgram: GlProgram

    init {
        val vertexShaderCode = """
            #version 300 es
            in vec4 aFramePosition;
            out vec2 vTexSamplingCoord;
            void main() {
              gl_Position = aFramePosition;
              vTexSamplingCoord = aFramePosition.xy * 0.5 + 0.5;
            }
        """.trimIndent()

        val fragmentShaderCode = """
            #version 300 es
            precision mediump float;
            uniform sampler2D texSampler;
            uniform int uOpCount;
            uniform int uType0; uniform float uX0; uniform float uY0; uniform float uW0; uniform float uH0;
            uniform int uType1; uniform float uX1; uniform float uY1; uniform float uW1; uniform float uH1;
            uniform int uType2; uniform float uX2; uniform float uY2; uniform float uW2; uniform float uH2;
            uniform int uType3; uniform float uX3; uniform float uY3; uniform float uW3; uniform float uH3;
            uniform int uType4; uniform float uX4; uniform float uY4; uniform float uW4; uniform float uH4;
            uniform int uType5; uniform float uX5; uniform float uY5; uniform float uW5; uniform float uH5;
            uniform int uType6; uniform float uX6; uniform float uY6; uniform float uW6; uniform float uH6;
            uniform int uType7; uniform float uX7; uniform float uY7; uniform float uW7; uniform float uH7;
            uniform int uType8; uniform float uX8; uniform float uY8; uniform float uW8; uniform float uH8;
            uniform int uType9; uniform float uX9; uniform float uY9; uniform float uW9; uniform float uH9;

            in vec2 vTexSamplingCoord;
            out vec4 outColor;

            vec4 frostedGlassSample(vec2 coord) {
                vec4 sum = vec4(0.0);
                float weightSum = 0.0;
                for (float dx = -4.0; dx <= 4.0; dx += 1.0) {
                    for (float dy = -4.0; dy <= 4.0; dy += 1.0) {
                        vec2 offset = vec2(dx, dy) * 0.0045;
                        float weight = exp(-(dx * dx + dy * dy) / 12.0);
                        sum += texture(texSampler, clamp(coord + offset, 0.0, 1.0)) * weight;
                        weightSum += weight;
                    }
                }
                vec4 blurred = sum / weightSum;
                // لمسة زجاج سائل داكنة ومريحة للعين بهوية SafePlayer
                vec3 glassTint = vec3(0.08, 0.09, 0.12);
                return vec4(mix(blurred.rgb, glassTint, 0.22), blurred.a);
            }

            void applyOp(int type, float x, float y, float w, float h, vec2 coord, inout vec4 color) {
                if (coord.x >= x && coord.x <= x + w && coord.y >= y && coord.y <= y + h) {
                    // حساب تدرج الحواف الناعمة (Smooth Feathering)
                    float feather = 0.02;
                    float edgeX = min(smoothstep(x, x + feather, coord.x), smoothstep(x + w, x + w - feather, coord.x));
                    float edgeY = min(smoothstep(y, y + feather, coord.y), smoothstep(y + h, y + h - feather, coord.y));
                    float blendFactor = (w >= 0.98 && h >= 0.98) ? 1.0 : clamp(edgeX * edgeY, 0.0, 1.0);

                    vec4 targetColor = color;
                    if (type == 0 || type == 1) {
                        targetColor = vec4(0.05, 0.05, 0.07, 1.0);
                    } else if (type == 2) {
                        targetColor = frostedGlassSample(coord);
                    } else if (type == 3) {
                        float pixels = 36.0;
                        vec2 d = vec2(1.0 / pixels, 1.0 / pixels);
                        vec2 pixelatedCoord = floor(coord / d) * d + d * 0.5;
                        targetColor = texture(texSampler, pixelatedCoord);
                    }
                    color = mix(color, targetColor, blendFactor);
                }
            }

            void main() {
                vec4 color = texture(texSampler, vTexSamplingCoord);
                vec2 coord = vTexSamplingCoord;

                if (uOpCount > 0) applyOp(uType0, uX0, 1.0-uY0-uH0, uW0, uH0, coord, color);
                if (uOpCount > 1) applyOp(uType1, uX1, 1.0-uY1-uH1, uW1, uH1, coord, color);
                if (uOpCount > 2) applyOp(uType2, uX2, 1.0-uY2-uH2, uW2, uH2, coord, color);
                if (uOpCount > 3) applyOp(uType3, uX3, 1.0-uY3-uH3, uW3, uH3, coord, color);
                if (uOpCount > 4) applyOp(uType4, uX4, 1.0-uY4-uH4, uW4, uH4, coord, color);
                if (uOpCount > 5) applyOp(uType5, uX5, 1.0-uY5-uH5, uW5, uH5, coord, color);
                if (uOpCount > 6) applyOp(uType6, uX6, 1.0-uY6-uH6, uW6, uH6, coord, color);
                if (uOpCount > 7) applyOp(uType7, uX7, 1.0-uY7-uH7, uW7, uH7, coord, color);
                if (uOpCount > 8) applyOp(uType8, uX8, 1.0-uY8-uH8, uW8, uH8, coord, color);
                if (uOpCount > 9) applyOp(uType9, uX9, 1.0-uY9-uH9, uW9, uH9, coord, color);

                outColor = color;
            }
        """.trimIndent()

        glProgram = GlProgram(context, vertexShaderCode, fragmentShaderCode)
    }

    private var inputSize: Size = Size.ZERO

    override fun configure(inputWidth: Int, inputHeight: Int): Size {
        inputSize = Size(inputWidth, inputHeight)
        return inputSize
    }

    override fun drawFrame(inputTexId: Int, presentationTimeUs: Long) {
        glProgram.use()
        glProgram.setSamplerTexIdUniform("texSampler", inputTexId, 0)

        val presentationTimeMs = presentationTimeUs / 1000
        val activeOps = operations.filter { op ->
            op.isEnabled && presentationTimeMs in op.startTimeMs..op.endTimeMs
        }.sortedBy {
            OperationProperties.fromJson(it.propertiesJson).zOrder
        }.take(10)

        glProgram.setIntUniform("uOpCount", activeOps.size)

        if (activeOps.isNotEmpty()) {
            for (i in activeOps.indices) {
                val op = activeOps[i]
                val baseProps = OperationProperties.fromJson(op.propertiesJson)
                val props = baseProps.getInterpolated(presentationTimeMs)

                val type = when (op.type) {
                    "CENSOR_BLACK" -> 0
                    "CENSOR_COVER" -> 1
                    "CENSOR_BLUR" -> 2
                    "CENSOR_PIXELATE" -> 3
                    else -> 2
                }

                var x = props.x
                var y = props.y
                var w = props.width
                var h = props.height

                if (type == 1) {
                    x = 0f
                    y = 0f
                    w = 1f
                    h = 1f
                }

                glProgram.setIntUniform("uType$i", type)
                glProgram.setFloatUniform("uX$i", x)
                glProgram.setFloatUniform("uY$i", y)
                glProgram.setFloatUniform("uW$i", w)
                glProgram.setFloatUniform("uH$i", h)
            }
        }

        glProgram.bindAttributesAndUniforms()
        android.opengl.GLES20.glDrawArrays(android.opengl.GLES20.GL_TRIANGLE_STRIP, 0, 4)
        GlUtil.checkGlError()
    }
}

5. إنشاء مكوّن الزجاج السائل للمشغل app/src/main/java/com/example/ui/theme/LiquidGlassModifiers.kt
أنشئ ملفاً جديداً باسم LiquidGlassModifiers.kt في المسار app/src/main/java/com/example/ui/theme/ مستوحى من معمارية Mpv-infinity لتطبيق التمويه الزجاجي الحقيقي (Hardware RenderEffect Blur على Android 12+ و AGSL على Android 13+) فوق الفيديو عند تفعيل isSafeBlurActive في PlayerScreen.kt:
package com.example.ui.theme

import android.graphics.RenderEffect
import android.graphics.Shader
import android.os.Build
import androidx.compose.foundation.background
import androidx.compose.foundation.border
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Brush
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.asComposeRenderEffect
import androidx.compose.ui.graphics.graphicsLayer
import androidx.compose.ui.unit.Dp
import androidx.compose.ui.unit.dp

/**
 * يطبق تمويه GPU مباشر على سطح الفيديو (PlayerView) عند تفعيل الحارس الذكي
 * دون التأثير على وضوح أزرار التحكم أو طبقة الواجهة.
 */
fun Modifier.safeVideoHardwareBlur(isBlurred: Boolean, blurRadiusPx: Float = 65f): Modifier {
    if (!isBlurred) return this
    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
        this.graphicsLayer {
            renderEffect = RenderEffect.createBlurEffect(
                blurRadiusPx,
                blurRadiusPx,
                Shader.TileMode.CLAMP
            ).asComposeRenderEffect()
        }
    } else {
        this
    }
}

/**
 * سطح زجاجي سائل ثلاثي الأبعاد (Liquid Glass Surface) بهوية SafePlayer الخاصة
 */
fun Modifier.liquidGlassSurface(
    cornerRadius: Dp = 20.dp,
    tintColor: Color = Color(0xCC12131A),
    rimLightColor: Color = Color(0x45FFFFFF)
): Modifier {
    val shape = RoundedCornerShape(cornerRadius)
    return this
        .clip(shape)
        .background(
            brush = Brush.verticalGradient(
                colors = listOf(
                    tintColor.copy(alpha = 0.85f),
                    tintColor.copy(alpha = 0.65f)
                )
            ),
            shape = shape
        )
        .border(
            width = 1.dp,
            brush = Brush.linearGradient(
                colors = listOf(
                    rimLightColor,
                    Color.Transparent,
                    rimLightColor.copy(alpha = 0.15f)
                )
            ),
            shape = shape
        )
}

6. ربط التمويه الزجاجي ونتائج الفحص التلقائي داخل PlayerScreen.kt و PlayerViewModel.kt
 * في PlayerScreen.kt: قم باستيراد com.example.ui.theme.safeVideoHardwareBlur و com.example.ui.theme.liquidGlassSurface، وأضف .safeVideoHardwareBlur(isSafeBlurActive) إلى Modifier الخاص بـ AndroidView الذي يعرض PlayerView حتى يتم تمويه إطار الفيديو نفسه عبر المعالج الرسومي (GPU) مع بقاء أزرار المشغل وشريط التقدم واضحة فوقه.
 * في PlayerViewModel.kt: تأكد أنه عند تحميل أي فيديو (loadMedia) يتم تلقائياً قراءة نتائج DetectionResult المحفوظة لهذا الفيديو من قاعدة البيانات وتحويلها إلى TimelineMarker مفعّلة في _markers، بحيث يعمل الحجب والتمويه التلقائي (isSafeBlurActive) وكتم الصوت (isSafeMuteActive) فور وصول المؤشر الزمني لأي فترة مكتشفة.
